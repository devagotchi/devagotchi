      "$description": "Hints, captions, badges."
    },
    "title": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{step.1}",
        "fontWeight": "{weight.bold}",
        "lineHeight": "{leading.tight}"
      },
      "$description": "The title of a card or dialog."

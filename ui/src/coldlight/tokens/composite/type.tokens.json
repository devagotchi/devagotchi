        "fontFamily": "{font.ui}",
        "fontSize": "{step.0}",
        "fontWeight": "{weight.medium}",
        "lineHeight": "{leading.tight}"
      },
      "$description": "Buttons, field labels, tabs."
    },
    "small": {
      "$value": {
        "fontFamily": "{font.ui}",

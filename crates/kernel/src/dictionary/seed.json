  "rules": [
    {
      "phrase": "users",
      "route": {
        "to": "elsewhere",
        "what": "reporting and analytics"
      },
      "cues": [
        "how many",
        "active",
        "analytics",
        "metrics",
        "count",
        "growth",
        "daily",
        "monthly",
        "report",
        "reports",
        "signups per"
      ],
      "note": "Users counted in a report are reporting, not identity."
    },
    {
      "phrase": "active users",
      "route": {
        "to": "elsewhere",
        "what": "reporting and analytics"
      },
      "note": "Active users is a report, not identity."
    },
    {
      "phrase": "admin user",
      "route": {
        "to": "split",
        "concepts": [
          "boundary/admin",
          "boundary/iam"
        ]
      },
      "note": "The privilege model is administration; the credential is identity."
    },
    {
      "phrase": "user settings",
      "route": {
        "to": "concept",
        "concept": "boundary/iam"
      },
      "cues": [
        "password",
        "login",
        "log in",
        "sign in",
        "session",
        "passkey",
        "two-factor",
        "2fa",
        "email"
      ],
      "note": "Credential and session settings are identity."
    },
    {
      "phrase": "user settings",
      "route": {
        "to": "elsewhere",
        "what": "preferences, on the product surface"
      },
      "note": "One person's preferences belong to the product, not identity."
    },
    {
      "phrase": "dashboard",
      "route": {
        "to": "concept",
        "concept": "boundary/admin"
      },
      "cues": [
        "users",
        "manage",
        "configuration",
        "config",
        "roles",
        "ban",
        "whole app",
        "everyone"
      ],
      "note": "A dashboard that manages users or the system is administration."
    },
    {
      "phrase": "dashboard",
      "route": {
        "to": "elsewhere",
        "what": "a product surface"
      },
      "note": "A dashboard alone is a product surface."
    },
    {
      "phrase": "backend",
      "route": {
        "to": "concept",
        "concept": "boundary/admin"
      },
      "cues": [
        "admin",
        "manage",
        "control panel",
        "staff"
      ],
      "note": "A backend where you manage things is administration."
    },
    {
      "phrase": "backend",
      "route": {
        "to": "ask",
        "question": "Do you mean the server code, the API, or pages where you manage the app?"
      },
      "note": "Backend alone can mean three things."
    },
    {
      "phrase": "settings",
      "route": {
        "to": "concept",
        "concept": "boundary/admin"
      },
      "cues": [
        "whole app",
        "everyone",
        "all users",
        "system",
        "site-wide"
      ],
      "note": "Settings for the whole system are administration."
    },
    {
      "phrase": "settings",
      "route": {
        "to": "concept",
        "concept": "boundary/iam"
      },
      "cues": [
        "password",
        "login",
        "sign in",
        "account",
        "session"
      ],
      "note": "Credential and session settings are identity."
    },
    {
      "phrase": "settings",
      "route": {
        "to": "ask",
        "question": "Settings for one person, or for the whole app?"
      },
      "note": "Settings alone can be either."
    },
    {
      "phrase": "chat",
      "route": {
        "to": "concept",
        "concept": "boundary/llm"
      },
      "cues": [
        "ai",
        "bot",
        "assistant",
        "ask it",
        "claude",
        "chatgpt",
        "gpt",
        "llm",
        "model"
      ],
      "note": "Chat with an AI is a conversational interface over the model, not messaging between people."
    },
    {
      "phrase": "comments",
      "route": {
        "to": "concept",
        "concept": "boundary/messaging"
      },
      "cues": [
        "real time",
        "live",
        "instantly",
        "typing"
      ],
      "note": "Comments that arrive as they happen are messaging."
    },
    {
      "phrase": "comments",
      "route": {
        "to": "elsewhere",
        "what": "a content feature"
      },
      "note": "Comments without real-time delivery are content, not messaging."
    },
    {
      "phrase": "notifications",
      "route": {
        "to": "elsewhere",
        "what": "notifications, a boundary of its own (queued)"
      },
      "note": "Notifications are their own boundary."
    },
    {
      "phrase": "train it on my data",
      "route": {
        "to": "concept",
        "concept": "boundary/llm"
      },
      "note": "This almost always means retrieval over your own documents, not fine-tuning."
    },
    {
      "phrase": "agent",
      "route": {
        "to": "concept",
        "concept": "boundary/llm"
      },
      "note": "An agent calls tools on its own, so the agency questions apply."
    },
    {
      "phrase": "the orm",
      "route": {
        "to": "concept",
        "concept": "stack/drizzle"
      },
      "cues": [
        "drizzle"
      ]
    },
    {
      "phrase": "the orm",
      "route": {
        "to": "concept",
        "concept": "stack/prisma"
      },
      "cues": [
        "prisma"
      ]
    },
    {
      "phrase": "the orm",
      "route": {
        "to": "ask",
        "question": "Which ORM: Drizzle or Prisma?"
      }
    },
    {
      "phrase": "migrations",
      "route": {
        "to": "concept",
        "concept": "stack/prisma"
      },
      "cues": [
        "prisma"
      ]
    },
    {
      "phrase": "migrations",
      "route": {
        "to": "concept",
        "concept": "stack/sql"
      },
      "note": "Migrations change the database's schema."
    }
  ]
}

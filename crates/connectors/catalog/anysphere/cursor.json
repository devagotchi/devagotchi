{
  "schema": "devagotchi.connector/v1",
  "id": "cursor",
  "name": "Cursor",
  "vendor": "anysphere",
  "surface": "ide",
  "remote_mcp": true,
  "transports": [
    "streamable-http",
    "sse",
    "stdio"
  ],
  "auth": {
    "oauth": true,
    "dynamic_client_registration": true,
    "bearer_header": true
  },
  "install": {
    "kind": "config-file",
    "command": null,
    "config_path": {
      "macos": "~/.cursor/mcp.json",
      "linux": "~/.cursor/mcp.json",
      "windows": "~/.cursor/mcp.json"
    },
    "project_config_path": ".cursor/mcp.json",
    "format": "json",
    "snippet": "{\n  \"mcpServers\": {\n    \"{name}\": {\n      \"url\": \"{url}\"\n    }\n  }\n}",
    "ui_steps": [
      "Customize in sidebar; install marketplace entries with Add to Cursor (runs OAuth)",
      "Toggle servers in Customize"
    ]
  },
  "instructions_file": ".cursor/rules/*.mdc and AGENTS.md",
  "hooks": null,
  "plan_limits": null,
  "aliases": [
    "cursor"
  ],
  "verification": {
    "level": "docs",
    "on": "2026-11-10",
    "docs": [
      "https://cursor.com/docs/context/mcp",
      "https://cursor.com/docs/context/rules"
    ],
    "test": null,
    "gaps": "Docs headers example is {API_KEY: value}; Authorization Bearer form is a generalization. Hooks not mentioned on fetched pages. Windows path for ~/.cursor not stated. Static OAuth via auth{CLIENT_ID,CLIENT_SECRET,scopes} exists. Shown without a token so the client signs in with OAuth, as this hub expects."
  }
}
